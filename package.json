{
  "name": "drafter",
  "description": "Home journal and planner: Home, Tasks, Calendar, People and Kitchen, with habits, routines, a weekly review, a command palette and an iOS shell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "eslint src --max-warnings 0 && vitest run && tsc --noEmit && vite build",
    "lint": "eslint src --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "build:ios": "tsc --noEmit && vite build --mode ios && cap sync ios",
    "ios": "npm run build:ios && cap open ios",
    "db:smoke": "bash scripts/db-smoke.sh",
    "mcp:smoke": "node scripts/mcp-smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@supabase/supabase-js": "^2.112.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^14.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.42.0",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
