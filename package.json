{
  "name": "drafter",
  "description": "Home journal and planner: Home, Tasks, Calendar, People and Kitchen, with habits, routines, a weekly review, a command palette and an iOS shell",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "npm run lint && vitest run && tsc --noEmit && tsc -p tsconfig.shared.json && tsc -p tsconfig.server.json && vite build && node scripts/check-precache.mjs",
    "lint": "eslint src netlify/functions mcp shared scripts e2e playwright.config.ts --max-warnings 0",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "tsc -p e2e && playwright test",
    "build:ios": "tsc --noEmit && vite build --mode ios && cap sync ios",
    "ios": "npm run build:ios && cap open ios",
    "db:smoke": "bash scripts/db-smoke.sh",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "ios:apple": "cp ios/App/App/App.paid.entitlements ios/App/App/App.entitlements && echo \"Push, Universal Links and Password AutoFill are on. Sign with the PAID team in Xcode, or the build will fail.\"",
    "version:patch": "node scripts/app-version.mjs --patch",
    "version:minor": "node scripts/app-version.mjs --minor",
    "version:major": "node scripts/app-version.mjs --major",
    "release:ios": "node scripts/ios-release.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@mediapipe/tasks-vision": "1.0.1",
    "@supabase/supabase-js": "^2.112.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^14.0.0",
    "patch-package": "^8.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
