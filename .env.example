# Copy to .env.local for local dev; set the same two vars in Netlify for deploys.
# With these unset the app runs in local mode (IndexedDB in the browser; there is no local server).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable key (sb_publishable_…) from Supabase → Project Settings → API Keys>
# A legacy anon key (a JWT) still works here until the project turns its legacy keys off.
# VITE_API_BASE=https://<your-site>   # iOS build only (committed in .env.ios): where the bundled app finds the API; empty on the web

# AI features (✨) — one key is enough; `netlify dev` passes these to /api/ai.
# Free NVIDIA key from https://build.nvidia.com (~40 req/min). Optional: NVIDIA_MODEL, AI_PROVIDER.
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_API_KEY_2=nvapi-...  # optional second key: scheduled work tries it first, and a 429 or 5xx on one key is tried once on the other
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_WORKSPACE_ID=   # only when that key is identity-linked rather than scoped to one workspace
# ANTHROPIC_MODEL=          # optional: the Claude model to use (default claude-opus-5)

# GITHUB_TOKEN=             # optional: private repos, Projects boards (the `project` scope) and write-back

# Calendar sync (optional). The per-user feed link and Google tokens are stored server-side, which needs:
# SUPABASE_SERVICE_KEY=<secret key (sb_secret_…)>   # functions only; never ships to the browser
#                                                   # a legacy service_role key still works until they are turned off
# OAUTH_STATE_SECRET=      # optional: signs the OAuth state of a Google or Outlook connect and the iOS sign-in
#                          # handoff. Any long random string. Falls back to SUPABASE_SERVICE_KEY, so setting it
#                          # keeps a key rotation from cutting off the connects already in the air.
# Google Calendar via OAuth (optional): Google Cloud → OAuth client (Web) with redirect URI
# https://<your-site>/api/google/callback. Tokens are stored server-side (needs SUPABASE_SERVICE_KEY).
# Enable the Google Calendar API and publish the OAuth consent screen (in Testing, refresh tokens expire after 7 days).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# BACKUP_PASSPHRASE=        # optional, recommended: encrypts each nightly snapshot; the server keeps no copy, so losing it loses them
# Push reminders (optional): `npx web-push generate-vapid-keys`, then on Netlify:
# VAPID_PUBLIC_KEY=  VAPID_PRIVATE_KEY=  VAPID_SUBJECT=mailto:you@example.com
# Morning digest by email (optional): RESEND_API_KEY=  DIGEST_FROM="Drafter <you@yourdomain>"
# Outlook / Microsoft 365 (optional): Azure Portal -> App registrations -> New registration,
# "any organizational directory and personal Microsoft accounts", redirect URI
# https://<your-site>/api/microsoft/callback. Tokens are stored server-side.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# Apple Developer Program (paid): the Team ID is not a secret. Netlify writes
# /.well-known/apple-app-site-association from it at build time.
# APPLE_TEAM_ID=<10-char Team ID>   # APPLE_BUNDLE_ID=app.drafter.ios
# iOS app push: Apple Developer -> Keys -> new key with APNs enabled.
# APNS_KEY_ID=<10-char key id>  APNS_TEAM_ID=<team id>  APNS_BUNDLE_ID=app.drafter.ios
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"   # the .p8 contents
# APNS_ENV=sandbox   # only for builds run from Xcode / TestFlight-less installs; omit for App Store / TestFlight

# Assistants (MCP): /api/mcp, /api/agents and the OAuth server need SUPABASE_SERVICE_KEY (above) plus the
# project URL and publishable key. Functions read SUPABASE_URL / SUPABASE_ANON_KEY, falling back to the VITE_ names.
# Apply supabase/migrations/20260921000000_agent_access.sql first; until then these endpoints answer 501.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=<publishable key>
# MCP_RATE_LIMIT_PER_MIN=60                                  # optional: calls a minute per connection
# OAUTH_REDIRECT_ALLOWLIST=claude.ai,claude.com,localhost,127.0.0.1   # optional: hosts an assistant may be sent back to
#
# Local stdio server only (node mcp/server.mjs, e.g. from Claude Desktop) — never on Netlify:
# DRAFTER_AGENT_TOKEN=drft_...                               # from Drafter → Settings → Assistants
# DRAFTER_MCP_URL=https://drafterz.netlify.app/api/mcp       # optional: point it at `netlify dev` to test locally
# DRAFTER_MCP_TIMEOUT_MS=                                    # optional: how long it waits for /api/mcp (default 30000)

# Set by Netlify itself on every deploy, never by hand; the OAuth server names its issuer from them.
# URL=                      # the site's main address
# DEPLOY_PRIME_URL=         # a deploy preview's or branch deploy's own address, used when CONTEXT is not production
# CONTEXT=                  # production, deploy-preview or branch-deploy
