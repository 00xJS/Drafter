# Copy to .env.local for local dev; set the same two vars in Netlify for deploys.
# With these unset the app runs in local mode (localStorage + optional `npm run server`).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key from `supabase projects api-keys`>

# AI features (✨) — one key is enough; `netlify dev` passes these to /api/ai.
# Free NVIDIA key from https://build.nvidia.com (~40 req/min). Optional: NVIDIA_MODEL, AI_PROVIDER.
# NVIDIA_API_KEY=nvapi-...
# ANTHROPIC_API_KEY=sk-ant-...
