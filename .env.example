# Copy to .env.local for local dev; set the same two vars in Netlify for deploys.
# With these unset the app runs in local mode (localStorage + optional `npm run server`).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key from `supabase projects api-keys`>

# AI features (✨) — one key is enough; `netlify dev` passes these to /api/ai.
# Free NVIDIA key from https://build.nvidia.com (~40 req/min). Optional: NVIDIA_MODEL, AI_PROVIDER.
# NVIDIA_API_KEY=nvapi-...
# ANTHROPIC_API_KEY=sk-ant-...

# Calendar sync (optional). The per-user feed link and Google tokens are stored server-side, which needs:
# SUPABASE_SERVICE_KEY=<service_role key>   # functions only; never ships to the browser
# Google Calendar via OAuth (optional): Google Cloud → OAuth client (Web) with redirect URI
# https://<your-site>/api/google/callback. Tokens are stored server-side (needs SUPABASE_SERVICE_KEY).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Push reminders (optional): `npx web-push generate-vapid-keys`, then on Netlify:
# VAPID_PUBLIC_KEY=  VAPID_PRIVATE_KEY=  VAPID_SUBJECT=mailto:you@example.com
# Morning digest by email (optional): RESEND_API_KEY=  DIGEST_FROM="Drafter <you@yourdomain>"
# Outlook / Microsoft 365 (optional): Azure Portal -> App registrations -> New registration,
# "any organizational directory and personal Microsoft accounts", redirect URI
# https://<your-site>/api/microsoft/callback. Tokens are stored server-side.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
