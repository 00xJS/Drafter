<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Empty on purpose. A free personal team cannot provision the Push
	     Notifications capability, so `aps-environment` here fails the build
	     with "Personal development teams do not support the Push
	     Notifications capability". Local (on-device) reminders need no
	     entitlement and are unaffected.

	     With an Apple Developer Program membership, add back:
	         <key>aps-environment</key><string>development</string>
	     (or `production` for TestFlight/App Store) and set the APNS_* vars.
	     For Universal Links and Password AutoFill, also add:
	         <key>com.apple.developer.associated-domains</key>
	         <array>
	             <string>applinks:drafterz.netlify.app</string>
	             <string>webcredentials:drafterz.netlify.app</string>
	         </array>
	     and publish ios/apple-app-site-association.example.json as
	     public/.well-known/apple-app-site-association. The whole list is in the
	     README under "When you join the Apple Developer Program", and in the app
	     under Admin, Apple. -->
</dict>
</plist>
