<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Empty while the team signing this build is a FREE personal one.
	     A personal team cannot provision Push Notifications or Associated
	     Domains, and asking for either fails the build outright:
	         "Personal development teams do not support the Push
	          Notifications capability"
	     Local (on-device) reminders and Face ID need no entitlement and are
	     unaffected, so everything Drafter does today still works.

	     The paid version of this file is kept beside it as
	     App.paid.entitlements — push, Universal Links and Password AutoFill.
	     Once the Apple Developer Program membership has cleared (it can take
	     up to 48 hours), swap it in:

	         npm run ios:apple

	     and swap back with `git checkout ios/App/App/App.entitlements` if you
	     ever return to free signing. -->
</dict>
</plist>
